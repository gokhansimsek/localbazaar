# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local development: point at the Postgres running on your host.
# Deployment: replace with the RDS endpoint, e.g.
#   postgresql+psycopg://<user>:<pass>@<rds-host>:5432/<db>
DATABASE_URL=postgresql+psycopg://local_bazaar:change_me@localhost:5432/local_bazaar

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
# Comma-separated list of allowed CORS origins for the Next.js dev server.
API_CORS_ORIGINS=http://localhost:3000
# Set to 1 to expose /docs, /redoc, and /openapi.json. Off by default; the
# local docker-compose env turns it on for dev convenience. Leave OFF in prod.
ENABLE_API_DOCS=0

# --- Scraper ---
SCRAPER_USER_AGENT=local_bazaar/0.1 (+contact: gokhan_simsek@windowslive.com)
# Daily scrape hour in Europe/Istanbul time (24h, integer).
SCRAPER_DAILY_HOUR=2
# Set to 1 to skip the daily scheduler (useful when running scrapers manually).
SCRAPER_DISABLE_SCHEDULER=0

# --- Google Maps Platform ---
# Used both server-side (geocoding markets to lat/lng) and client-side (rendering the map).
# Leave empty to disable geocoding — markets are still scraped, but without coordinates.
GOOGLE_MAPS_API_KEY=

# --- Admin review (hidden /admin/suggestions page) ---
# Shared secret to access the place-suggestion review page. Leave empty to keep
# the admin API disabled (returns 503). Set to a long random string to enable.
ADMIN_TOKEN=

# --- Frontend (Next.js) ---
# The API is NOT publicly exposed. The Next.js server proxies same-origin
# /api/* calls from the browser to this internal URL (see apps/web/next.config.mjs).
# Locally with docker compose: http://api:8000 (Docker DNS).
# In Kubernetes: http://api (cluster-local Service).
API_INTERNAL_URL=http://api:8000
# Leave NEXT_PUBLIC_API_URL UNSET so the browser uses same-origin /api.
# Only set this if you need to point the browser at a different host (rare).
# NEXT_PUBLIC_API_URL=
# Same Google Maps key, exposed to the browser. Restrict by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- API rate limit (slowapi) ---
# Per-IP cap across every /api/* route. Format: "<count>/<window>".
# Increase if your CDN/edge caches help, or to a wider window for crawlers.
API_RATE_LIMIT=120/minute

# --- Google AdSense + Funding Choices CMP ---
# Publisher ID. Format: "ca-pub-XXXXXXXXXXXXXXXX". When empty the loader,
# Funding Choices script, ad slots, and ads.txt all stay inert — perfect for
# preview deploys / local dev.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Ad-unit slot ID for the /trends page (a numeric string like "1234567890").
NEXT_PUBLIC_ADSENSE_TRENDS_SLOT=
# Set to "1" to inject the Google Funding Choices CMP loader. AdSense requires
# an IAB-TCFv2.2 CMP for EU/UK traffic; keep this on whenever ads are enabled
# in a region with consent requirements. Configure the messages themselves in
# the AdSense console under "Privacy & messaging".
NEXT_PUBLIC_ADSENSE_CMP_ENABLED=1
